{
  "name": "seventh-terminal",
  "version": "2.0.0",
  "private": true,
  "description": "The 7th Terminal — faction war dibs + stocks advisor for Torn",
  "scripts": {
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview",
    "sync:dev": "npx wrangler dev sync/worker.js --config sync/wrangler.toml",
    "sync:deploy": "npx wrangler deploy --config sync/wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
